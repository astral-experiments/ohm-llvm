# RUN: llc -mtriple=x86_64-unknown-linux-gnu -run-pass=livedebugvalues -experimental-debug-variable-locations=true %s -o - | FileCheck %s
# CHECK-LABEL: name: substitution_order
# CHECK: debugValueSubstitutions:
# CHECK-NEXT: - { srcinst: 4,
# CHECK-NEXT: - { srcinst: 22,

--- |
  define void @substitution_order() !dbg !4 {
    ret void, !dbg !8
  }
  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!5}
  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, producer: "ldv", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "ldv.c", directory: "/")
  !2 = !DISubroutineType(types: !3)
  !3 = !{null}
  !4 = distinct !DISubprogram(name: "substitution_order", scope: !1, file: !1, line: 1, type: !2, scopeLine: 1, spFlags: DISPFlagDefinition, unit: !0, retainedNodes: !9)
  !5 = !{i32 2, !"Debug Info Version", i32 3}
  !6 = !DIBasicType(name: "long", size: 64, encoding: DW_ATE_signed)
  !7 = !DILocalVariable(name: "stack_source", scope: !4, file: !1, line: 1, type: !6)
  !8 = !DILocation(line: 1, column: 1, scope: !4)
  !9 = !{!7}
...
---
name: substitution_order
tracksRegLiveness: true
debugInstrRef: true
debugValueSubstitutions:
  - { srcinst: 22, srcop: 0, dstinst: 21, dstop: 0, subreg: 0 }
  - { srcinst: 4, srcop: 0, dstinst: 3, dstop: 0, subreg: 0 }
stack:
  - { id: 0, type: default, offset: -8, size: 8, alignment: 8, debug-info-variable: '!7', debug-info-expression: '!DIExpression()', debug-info-location: '!8' }
body: |
  bb.0:
    liveins: $rdi
    RET64
...
